[Desktop Entry]
Type=Application
Name=Diagnostic manettes Xbox
Comment=Signaler une coupure et exporter les journaux manettes
Exec=${HOME}/.local/bin/diagnostic-manettes
Icon=input-gaming
Terminal=false
Categories=Utility;
Actions=DotfilesOpenProgram;DotfilesOpenLauncher;
X-Dotfiles-AppLocations-Managed=true
X-Dotfiles-AppLocations-Generated=false
X-Dotfiles-AppLocations-Source=file://${HOME}/.local/share/applications/diagnostic-manettes.desktop

[Desktop Action DotfilesOpenProgram]
Name=Open executable folder
Name[fr]=Ouvrir le dossier du programme
Icon=folder-open
Exec="${HOME}/.local/bin/kde-app-locations" open program "file://${HOME}/.local/share/applications/diagnostic-manettes.desktop"

[Desktop Action DotfilesOpenLauncher]
Name=Open launcher folder
Name[fr]=Ouvrir le dossier du raccourci
Icon=folder-open
Exec="${HOME}/.local/bin/kde-app-locations" open launcher "file://${HOME}/.local/share/applications/diagnostic-manettes.desktop"
