@@ -0,0 +1,66 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+// Local RGB profile, based on the inspected WaveCreator color stage.
+// This is an independent implementation, not an exact desktop-renderer clone.
+namespace rgbreference {
+inline std::array<float, 3> color(float low, float mid, float high) {
+    const float peak = std::max({low, mid, high});
+    if (!(peak > 0.f)) return {0.f, 0.f, 0.f};
+    float r = 255.f * low / peak;
+    float g = 255.f * mid / peak;
+    float b = 255.f * high / peak;
+    if (b < 64.f) {
+        const float delta = (0.0013071896974f - b * 0.00002042483902f) * g * r;
+        r -= delta;
+        g -= delta;
+    }
+    g *= 1.f - std::min(std::max(b, r), 128.f) * 0.002343750093f;
+    b *= 1.2999999523f;
+    return {std::clamp(r / 255.f, 0.f, 1.f),
+            std::clamp(g / 255.f, 0.f, 1.f),
+            std::clamp(b / 255.f, 0.f, 1.f)};
+}
+
+class Biquad {
+  public:
+    Biquad(double rate, double cutoff, bool highpass) {
+        const double w = 2.0 * 3.14159265358979323846 * std::min(cutoff, rate * .45) / rate;
+        const double c = std::cos(w), a = std::sin(w) / std::sqrt(2.0);
+        const double inv = 1.0 / (1.0 + a);
+        b0 = (highpass ? 1.0 + c : 1.0 - c) * .5 * inv;
+        b1 = (highpass ? -2.0 : 2.0) * b0;
+        b2 = b0;
+        a1 = -2.0 * c * inv;
+        a2 = (1.0 - a) * inv;
+    }
+    double sample(double x, int channel) {
+        const double y = b0*x + z1[channel];
+        z1[channel] = b1*x - a1*y + z2[channel];
+        z2[channel] = b2*x - a2*y;
+        return y;
+    }
+  private:
+    double b0{}, b1{}, b2{}, a1{}, a2{};
+    double z1[2]{}, z2[2]{};
+};
+class Band {
+  public:
+    Band(double rate, int band)
+        : first(rate, band == 0 ? 100.0 : band == 1 ? 300.0 : 1500.0, band != 0),
+          second(rate, 3000.0, false), cascade(band == 1) {}
+    void assumeSettled() {}
+    void process(const float* input, float* output, int count) {
+        for (int i = 0; i < count; ++i) {
+            double y = first.sample(input[i], i % 2);
+            if (cascade) y = second.sample(y, i % 2);
+            output[i] = static_cast<float>(y);
+        }
+    }
+  private:
+    Biquad first, second;
+    bool cascade;
+};
+} // namespace rgbreference
