#!/usr/bin/env bash
set -euo pipefail

data="${XDG_DATA_HOME:-$HOME/.local/share}/spotify-launcher"
prefs="${XDG_CONFIG_HOME:-$HOME/.config}/spotify/prefs"
apps="$data/install/usr/share/spotify/Apps"
spicetify="$HOME/.spicetify/spicetify"

# Lors de la première ouverture, Spotify écrit sa version dans prefs.
[[ -f "$apps/xpui.spa" && -f "$prefs" && -f "$data/state.json" ]] || exit 0
last_version=$(sed -n 's/^app\.last-launched-version="\([^"]*\)"$/\1/p' "$prefs")
installed_version=$(python3 -c 'import json, sys; print(json.load(sys.stdin)["version"].split(":")[-1])' < "$data/state.json")
if [[ "$last_version" != "$installed_version" ]]; then
    echo "Spicetify sera appliqué à la prochaine ouverture de Spotify."
    exit 0
fi

"$spicetify" --no-restart backup apply
