#!/usr/bin/env python3
"""Icône de notification du serveur LLM local (llama.cpp) — PyQt6, compatible Plasma Wayland.

Config : ~/.config/llm-server/config.ini
  [server]   launcher = chemin de serve.sh · log = fichier de log
  [endpoint] host / port (API OpenAI-compatible, Web UI)
  [tray]     auto_load = true|false (charge le modèle au lancement de l'icône)
Le serveur est un processus enfant de l'icône : quitter l'icône l'arrête.
"""
import configparser
import os
import signal
import subprocess
import sys
import urllib.request
from pathlib import Path

from PyQt6.QtCore import QTimer, Qt
from PyQt6.QtGui import QColor, QIcon, QPainter, QPixmap
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

CFG = Path.home() / ".config/llm-server/config.ini"
AUTOSTART = Path.home() / ".config/autostart/llm-tray.desktop"


def load():
    cp = configparser.ConfigParser()
    cp.read(CFG)
    return {
        "launcher": cp.get("server", "launcher"),
        "log": os.path.expanduser(cp.get("server", "log", fallback="~/logs/llm-server.log")),
        "host": cp.get("endpoint", "host", fallback="localhost"),
        "port": cp.getint("endpoint", "port", fallback=8081),
        "auto_load": cp.getboolean("tray", "auto_load", fallback=False),
        "name": cp.get("tray", "name", fallback="LLM local"),
    }


def save_auto_load(on: bool):
    cp = configparser.ConfigParser()
    cp.read(CFG)
    if not cp.has_section("tray"):
        cp.add_section("tray")
    cp.set("tray", "auto_load", "true" if on else "false")
    with open(CFG, "w") as f:
        cp.write(f)


def dot(color):
    px = QPixmap(22, 22)
    px.fill(Qt.GlobalColor.transparent)
    p = QPainter(px)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(color))
    p.setPen(Qt.PenStyle.NoPen)
    p.drawEllipse(3, 3, 16, 16)
    p.end()
    return QIcon(px)


class Tray:
    def __init__(self, app):
        self.app = app
        self.cfg = load()
        self.proc = None
        self.state = None
        self.tray = QSystemTrayIcon(dot("#6c7086"))
        self.menu = QMenu()
        self.tray.setContextMenu(self.menu)
        self.menu.aboutToShow.connect(self.build_menu)
        self.tray.activated.connect(self.on_click)
        self.tray.show()
        self.build_menu()
        t = QTimer(self.tray)
        t.timeout.connect(self.poll)
        t.start(3000)
        if self.cfg["auto_load"]:
            self.start()
        self.poll()

    def url(self, path=""):
        return f"http://{self.cfg['host']}:{self.cfg['port']}{path}"

    def healthy(self):
        try:
            with urllib.request.urlopen(self.url("/health"), timeout=1.5) as r:
                return r.status == 200
        except Exception:
            return False

    def running(self):
        return self.proc is not None and self.proc.poll() is None

    def start(self):
        if self.running():
            return
        Path(self.cfg["log"]).parent.mkdir(parents=True, exist_ok=True)
        log = open(self.cfg["log"], "ab")
        self.proc = subprocess.Popen([self.cfg["launcher"]], stdout=log, stderr=subprocess.STDOUT,
                                     start_new_session=True)
        self.poll()

    def stop(self):
        if self.running():
            try:
                os.killpg(os.getpgid(self.proc.pid), signal.SIGTERM)
                self.proc.wait(timeout=15)
            except Exception:
                try:
                    os.killpg(os.getpgid(self.proc.pid), signal.SIGKILL)
                except Exception:
                    pass
        self.proc = None
        self.poll()

    def poll(self):
        if self.healthy():
            state = "ready"
        elif self.running():
            state = "loading"
        else:
            state = "stopped"
        if state != self.state:
            self.state = state
            color, txt = {"ready": ("#a6e3a1", "prêt"), "loading": ("#f9e2af", "chargement…"),
                          "stopped": ("#6c7086", "arrêté")}[state]
            self.tray.setIcon(dot(color))
            self.tray.setToolTip(f"{self.cfg['name']} — {txt}\n{self.url('/v1')}")

    def on_click(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger and self.state == "ready":
            subprocess.Popen(["xdg-open", self.url()])

    def build_menu(self):
        m = self.menu
        m.clear()
        h = m.addAction(self.tray.toolTip().split("\n")[0] or self.cfg["name"])
        h.setEnabled(False)
        m.addSeparator()
        if self.running() or self.state == "ready":
            m.addAction("Arrêter le serveur", self.stop)
            m.addAction("Ouvrir la Web UI", lambda: subprocess.Popen(["xdg-open", self.url()]))
        else:
            m.addAction("Démarrer le serveur", self.start)
        m.addAction("Voir le log", lambda: subprocess.Popen(["konsole", "-e", "tail", "-n", "200", "-f", self.cfg["log"]]))
        m.addSeparator()
        a = m.addAction("Lancer à la connexion")
        a.setCheckable(True)
        a.setChecked(AUTOSTART.exists())
        a.toggled.connect(self.toggle_autostart)
        b = m.addAction("Charger le modèle au lancement")
        b.setCheckable(True)
        b.setChecked(load()["auto_load"])
        b.toggled.connect(save_auto_load)
        m.addSeparator()
        m.addAction("Quitter (arrête le serveur)", self.quit)

    def toggle_autostart(self, on):
        if on:
            AUTOSTART.parent.mkdir(parents=True, exist_ok=True)
            AUTOSTART.write_text("[Desktop Entry]\nType=Application\nName=Serveur LLM (icône)\n"
                                 f"Exec={Path(sys.argv[0]).resolve()}\nTerminal=false\n")
        else:
            AUTOSTART.unlink(missing_ok=True)

    def quit(self):
        self.stop()
        self.app.quit()


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    tray = Tray(app)
    signal.signal(signal.SIGTERM, lambda *_: tray.quit())
    sys.exit(app.exec())
